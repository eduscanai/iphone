# Modelo de ~/.morecheck/producao.env (guia 7.12 e 7.13). Copie, preencha e proteja:
#   cp deploy/producao.env.exemplo ~/.morecheck/producao.env && chmod 600 ~/.morecheck/producao.env
# Nunca versionar o arquivo preenchido.

# --- Backend ---
DATABASE_URL=postgresql+psycopg://morecheck:<senha>@localhost/morecheck
URL_PUBLICA=https://api-check.more-megastore.com
ESTETICA_ARMAZENAMENTO=s3
S3_ENDPOINT_URL=https://<conta>.r2.cloudflarestorage.com
S3_BUCKET_ESTETICA=morecheck-estetica
S3_ACCESS_KEY_ID=<chave>
S3_SECRET_ACCESS_KEY=<segredo>
ESTETICA_SEGREDO_URLS=<openssl rand -hex 32>
ESTETICA_TAMANHO_MAX_MB=40
ESTETICA_RETENCAO_MESES=12
ESTETICA_ROTEIRO=roteiro-v1            # D3: roteiro-v1 (espelhos) ou roteiro-v1-em-pe
ESTETICA_RASANTE_JUNTAS=false          # D1
ESTETICA_CONTRALUZ=false               # D4
ESTETICA_KAPPA_TECNICOS=               # kappa da fase 1 (sem ele, o gate nunca passa)
ESTETICA_PERCENTUAL_HOLDOUT=10
VISAO_WORKER_TOKENS=<openssl rand -hex 24>[,<outro worker>]
PAINEL_DIR=/opt/morecheck/painel/dist

# --- Worker de visão (na máquina do worker) ---
MORECHECK_API_URL=https://api-check.more-megastore.com
VISAO_WORKER_TOKEN=<um dos VISAO_WORKER_TOKENS>
VISAO_WORKER_ID=mac-loja-1
VISAO_DISPOSITIVO=mps                  # cpu, mps ou cuda (D6)
VISAO_DIR_MODELOS=/Users/<usuario>/.morecheck/modelos

# --- Cabine ---
CABINE_LUZ_CHAVE=<openssl rand -hex 16>   # vai no segredos.h do ESP32 e no app

# --- Ferramentas ---
ROBOFLOW_API_KEY=<chave>
